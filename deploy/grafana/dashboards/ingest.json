    {
      "id": 15,
      "title": "Route pool",
      "description": "A shared corpus of real routes, so fleet size and Valhalla load stay independent variables.",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 19,
        "w": 8,
        "h": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "surge_sim_route_pool_size",
