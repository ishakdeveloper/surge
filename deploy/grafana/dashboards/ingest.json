    {
      "id": 16,
      "title": "Valhalla route fetch",
      "description": "`no_route` is expected: the bounding box includes the IJ, and points in water do not route.",
      "type": "timeseries",
      "gridPos": {
        "x": 8,
        "y": 19,
        "w": 8,
        "h": 6
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum(rate(surge_sim_route_fetch_seconds_bucket[1m])) by (le, outcome))",
          "legendFormat": "p99 {{outcome}}",
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          }
        }
