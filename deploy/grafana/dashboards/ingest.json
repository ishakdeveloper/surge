            "type": "prometheus",
            "uid": "prometheus"
          }
        },
        {
          "expr": "rate(process_cpu_seconds_total{service=\"ingest\"}[1m])",
          "legendFormat": "ingest CPU cores",
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
