# Values that are the same everywhere. Anything that differs between a laptop
# and production belongs in that environment's overlay, not here.
#
# Addresses are in-cluster Service names, so no service knows whether the thing
# it talks to is one pod or twenty.

TRIP_GRPC_LISTEN=:8110
TRIP_GRPC_ADDR=trip:8110

CHAT_GRPC_LISTEN=:8113
CHAT_GRPC_ADDR=chat:8113

GATEWAY_HTTP_ADDR=:8100

AUTH_JWKS_URL=http://auth:3200/api/auth/jwks
AUTH_ISSUER=http://auth:3200
AUTH_AUDIENCE=surge
