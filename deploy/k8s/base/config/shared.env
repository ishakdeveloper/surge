# Read by every Go service. KAFKA_BROKERS, KAFKA_REPLICATION_FACTOR and
# OTEL_EXPORTER_OTLP_ENDPOINT differ per environment, so each overlay sets them.
#
# Sampled everywhere: exporting every span at ten thousand pings a second makes
# the collector the bottleneck and the service under test spend its time on
# telemetry.
OTEL_TRACES_SAMPLER_ARG=0.01
