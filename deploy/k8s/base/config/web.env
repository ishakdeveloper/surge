# SURGE_API_URL, SURGE_WS_URL and AUTH_BASE_URL are what the browser is told,
# at runtime, by the server that renders the page — so one image serves every
# environment. Each overlay sets them.
#
# AUTH_INTERNAL_URL is the same service as the server reaches it: resolving a
# session during server rendering should not leave the cluster and come back
# through the load balancer.
PORT=5273
AUTH_INTERNAL_URL=http://auth:3200
