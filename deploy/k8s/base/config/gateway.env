# In-cluster Service names, so the gateway never knows whether what it talks to
# is one pod or twenty. AUTH_ISSUER and GATEWAY_ORIGINS are public addresses,
# and the overlays set them.
GATEWAY_HTTP_ADDR=:8100
GATEWAY_METRICS_ADDR=:9104
TRIP_GRPC_ADDR=trip:8110
PAYMENTS_GRPC_ADDR=payments:8112

# Fetched in-cluster. The issuer it checks against is the public address auth
# signs with, not this one.
AUTH_JWKS_URL=http://auth:3200/api/auth/jwks
AUTH_AUDIENCE=surge
