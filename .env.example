DATABASE_URL=postgresql://forge:forge@localhost:5432/forge
DATABASE_SSL=false
# PORT is the API server's port; the client takes its own from WEB_URL, so
# `pnpm dev` can run both without a second variable to keep in step.
PORT=3000

# better-auth. Generate a secret with: openssl rand -base64 32
AUTH_SECRET=
AUTH_BASE_URL=http://localhost:3000
WEB_URL=http://localhost:5173

# The API's address as the browser sees it. VITE_-prefixed because it is baked
# into the client bundle — a public address, not a secret. Every auth route and
# every RPC lives on the API, so the browser talks to it directly.
VITE_AUTH_BASE_URL=http://localhost:3000

# Only when the web app and the API sit on different subdomains of one parent,
# so the session cookie can be scoped to `.example.com` and count as same-site.
# Leave empty when they share a host, as they do locally.
#
# It cannot be a public suffix: two *.up.railway.app hosts can never share a
# cookie, so splitting the two across Railway's generated domains needs a domain
# of your own.
AUTH_COOKIE_DOMAIN=

# Optional: enables "Sign in with Google" when both are set.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Transactional email only. Bulk or marketing sending must not share this account —
# Resend's terms require recipient consent, and sharing a domain would put auth
# deliverability at risk.
#
# Left empty, mail is written to the server log rather than sent, so magic links
# and verification mails are followable on a fresh clone with no account.
RESEND_API_KEY=
EMAIL_FROM=forge@example.com

# Tracing. Unset means no exporter is installed at all — pointing one at nothing
# retries on a schedule and fills the log with connection failures.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=forge-server
# Sent as the Authorization header, which is what hosted collectors expect.
OTEL_EXPORTER_OTLP_HEADERS=
