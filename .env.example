# Two databases, because there are two owners and nothing joins across them.
#
# DATABASE_URL is what the Go services use — trip, and anything they add.
# AUTH_DATABASE_URL is better-auth's, and no Go service connects to it.
# Pointing either at the other's database is the mistake the split prevents,
# which is why they are not called DATABASE_URL and DATABASE_URL_2.
DATABASE_URL=postgresql://surge:surge@localhost:55433/surge
AUTH_DATABASE_URL=postgresql://surge:surge@localhost:55433/surge_auth
DATABASE_SSL=false
# PORT is the auth service's port. 3200 rather than 3000 because this machine
# already runs projects on 3000, 3001 and 3100; the Go services take 8100+ and
# expose metrics on 9101+. The client takes its own port from WEB_URL.
PORT=3200

# better-auth. Generate a secret with: openssl rand -base64 32
AUTH_SECRET=
AUTH_BASE_URL=http://localhost:3200
WEB_URL=http://localhost:5273

# Signing in is an email or phone one-time code. Without RESEND_API_KEY and
# TWILIO_ACCOUNT_SID (below), emails and texts are written to this service's
# log instead of sent. Development only — never in a deployment: with this
# true, the last code "sent" to an address or number is also served at
# GET /dev/outbox?to=…, which is how the integration tests, the Go contract
# test and the end-to-end flows in apps/mobile/e2e read a code to type it; they
# skip without it. Codes a real provider delivers are never recorded.
AUTH_DEV_OUTBOX=true

# The native app's origins, comma separated. `surge://` is the built app;
# `exp://` is Expo Go, which is how `make dev-mobile` runs it. Origins that are
# not http match by prefix. Unset means `surge://` alone, which keeps Expo Go
# out of a deployment. apps/mobile/.env.example has the app's own settings.
AUTH_MOBILE_ORIGINS=surge://,exp://

# The auth service's address as the browser sees it. VITE_-prefixed because it
# is baked into the client bundle — a public address, not a secret. Auth flows
# go here; every product API is Go and lives behind SURGE_API_URL below.
VITE_AUTH_BASE_URL=http://localhost:3200

# Only when the web app and the API sit on different subdomains of one parent,
# so the session cookie can be scoped to `.example.com` and count as same-site.
# Leave empty when they share a host, as they do locally.
#
# It cannot be a public suffix: two *.up.railway.app hosts can never share a
# cookie, so splitting the two across Railway's generated domains needs a domain
# of your own.
AUTH_COOKIE_DOMAIN=

# Optional: enables "Sign in with Google" when both are set.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Transactional email only. Bulk or marketing sending must not share this account —
# Resend's terms require recipient consent, and sharing a domain would put auth
# deliverability at risk.
#
# Left empty, mail is written to the server log rather than sent, so magic links
# and verification mails are followable on a fresh clone with no account.
RESEND_API_KEY=
EMAIL_FROM=surge@example.com

# Text messages — phone sign-in codes — are sent by Twilio when all three are
# set, and written to this service's log, like mail without a Resend key, when
# the account SID is empty. TWILIO_FROM is a number the account owns, in E.164
# (+3197…); an alphanumeric sender ID (Surge) where the country allows one, as
# the Netherlands does; or a Messaging Service SID (MG…), which picks a sender
# per country. Never a personal mobile: Twilio sends only from what it owns. A
# trial account needs a Twilio number, and texts only numbers verified in its
# console, each message prefixed with a note that it came from a trial.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Twilio's test credentials (Console → Account → API keys & tokens → Test
# credentials), for the contract test in apps/auth/test/sms. They send nothing
# and cost nothing, and a test never uses any other credentials — so the live
# ones above can sit in the same file without a test ever texting anyone.
# TWILIO_TEST_ACCOUNT_SID=
# TWILIO_TEST_AUTH_TOKEN=

# Tracing. Unset means no exporter is installed at all — pointing one at nothing
# retries on a schedule and fills the log with connection failures.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=surge-auth
# Sent as the Authorization header, which is what hosted collectors expect.
OTEL_EXPORTER_OTLP_HEADERS=

# --- Go services -------------------------------------------------------------
# The browser talks to the Go gateway directly for every product API and for the
# WebSocket, carrying the JWT it fetched from /api/auth/token. Node is never in
# that path.
VITE_SURGE_API_URL=http://localhost:8100
VITE_SURGE_WS_URL=ws://localhost:8100/ws

# Address search: a Photon instance over OpenStreetMap. Empty means the public
# one at photon.komoot.io, which is fair-use only and answers some clients with
# a 503 — fine on a laptop, not for a deployment, which points this at its own.
VITE_PLACES_URL=

KAFKA_BROKERS=localhost:19092
REDIS_ADDR=localhost:56380
VALHALLA_URL=http://localhost:8002

# Go verifies tokens against this JWKS, fetched once and cached. It is the auth
# service's *internal* address: server-to-server, never the browser's.
AUTH_JWKS_URL=http://localhost:3200/api/auth/jwks
AUTH_ISSUER=http://localhost:3200
AUTH_AUDIENCE=surge

# The simulator mints its own driver tokens with this HMAC secret rather than
# creating 10,000 real accounts. The gateway only accepts them when SIM_ENABLED
# is true, which is what keeps this out of any real deployment.
SIM_ENABLED=true
SIM_TOKEN_SECRET=

# --- gateway ---------------------------------------------------------------
# The edge: REST for riders, WebSocket for drivers, gRPC to everything behind.
GATEWAY_HTTP_ADDR=:8100
GATEWAY_ORIGINS=http://localhost:5273
TRIP_GRPC_ADDR=localhost:8110
CHAT_GRPC_ADDR=localhost:8113
CORE_GRPC_ADDR=localhost:8114
FLEET_GRPC_ADDR=localhost:8115
# The simulator's control over gRPC: where simd listens, and where the gateway dials.
SIM_GRPC_LISTEN=:8111
SIM_GRPC_ADDR=localhost:8111
# Trips and hotspots, both off by default so older benchmarks stay comparable.
# SIM_TRIP_KM: an accepted driver drives to the pickup, then carries the rider
# about this far, reporting enroute_pickup and on_trip — supply drains, and
# ingest observes real pickups for ETA learning. SIM_HOTSPOT_SHARE: the share
# of pickups drawn near Centraal, Zuid or Leidseplein instead of anywhere.
SIM_TRIP_KM=0
SIM_HOTSPOT_SHARE=0

# Matching: greedy offers each rider the nearest car on arrival; batched
# gathers MATCHER_BATCH_WINDOW of requests and solves them together over
# Valhalla travel times.
MATCH_STRATEGY=greedy
MATCHER_BATCH_WINDOW=2s

# Whether a driver has to be approved by the fleet to be offered a trip. On,
# the matcher follows `fleet.drivers` and dispatches nobody it does not find
# approved there; off, it dispatches whoever is pinging.
#
# Off on a laptop, because the simulator's drivers never uploaded a licence and
# every benchmark was run on them. Turn it on to try the real path: onboard a
# driver through the fleet, approve their papers, and watch a driver whose
# papers are not in order be passed over.
MATCHER_REQUIRE_APPROVAL=false

# --- payments --------------------------------------------------------------
# The only process that holds processor credentials. It acts on trip.lifecycle
# and answers on payment.events; nothing calls it synchronously.
#
# fake simulates holds, captures and transfers with Stripe's test-card
# behaviour and charges nobody — right for a laptop. Unset, the service asks
# for Stripe and refuses to start without a key, so a real deploy cannot fall
# back to free rides by forgetting a variable.
PAYMENTS_PROCESSOR=fake
# Where payments listens, and where the gateway dials it.
PAYMENTS_GRPC_LISTEN=:8112
PAYMENTS_GRPC_ADDR=localhost:8112
PAYMENTS_METRICS_ADDR=:9107
# The web app, for the addresses the processor sends a driver back to after
# onboarding. The server's own setting, never taken from a request.
PAYMENTS_WEB_URL=http://localhost:5273
# The platform's share of a fare, in basis points: 2000 is 20%.
PAYMENTS_COMMISSION_BPS=2000
PAYMENTS_GROUP=payments

# Stripe, when PAYMENTS_PROCESSOR=stripe. Test-mode keys only in this file, and
# prefer a restricted key (rk_test_) with just what payments calls: customers,
# setup intents, payment intents, transfers, refunds, payouts, v2 accounts and
# account links, account sessions, login links; balance and events read-only.
STRIPE_SECRET_KEY=
# The signing secret `make stripe-listen` prints. A deployed webhook endpoint
# and event destination each have their own; locally one covers both.
STRIPE_WEBHOOK_SECRET=
STRIPE_THIN_WEBHOOK_SECRET=
# A payment method configuration limited to methods that can be held and
# captured later — cards and wallets. Empty uses the account's default.
PAYMENTS_PAYMENT_METHOD_CONFIG=
# Public by design: it only lets Stripe.js collect a card for this account.
VITE_STRIPE_PUBLISHABLE_KEY=

# --- chat ------------------------------------------------------------------
# Rider and driver about a trip, and either of them with support. Opens and
# closes trip conversations from trip.lifecycle; the gateway proxies its REST.
#
# fake logs notifications and notifies nobody. Unset, the service refuses to
# start, so a deploy cannot run without pushes by forgetting to choose.
CHAT_PUSH_PROVIDER=fake
# Only when the Expo project turns on enhanced push security.
EXPO_ACCESS_TOKEN=
CHAT_GRPC_LISTEN=:8113
CHAT_METRICS_ADDR=:9108
CHAT_GROUP=chat
# How long after a trip ends its conversation still takes messages, and how
# long a message waits to be read before its recipient is notified.
CHAT_CLOSE_GRACE=1h
CHAT_PUSH_DELAY=8s
CHAT_RATE_LIMIT=20

# --- core ------------------------------------------------------------------
# Who someone is to the people they ride with: a first name and a photo. The
# only process holding the object store's keys. A photo is cropped and
# re-encoded here — dropping the location a phone writes into it — before it is
# stored, and what leaves is a signed link.
#
# r2 stores photos in Cloudflare R2; memory keeps them in the process, gone on
# restart, for a laptop without keys. Unset, the service refuses to start, and
# `make dev-core` chooses memory unless this says otherwise.
AVATAR_STORE=memory
CORE_GRPC_LISTEN=:8114
CORE_METRICS_ADDR=:9109
# When AVATAR_STORE=r2. The account id is the one in the bucket's S3 URL,
# https://<account id>.r2.cloudflarestorage.com. The keys are an R2 API token's
# (Cloudflare → R2 → Manage API tokens), scoped to object read and write on
# this one bucket. The bucket stays private; photos are read through links the
# service signs.
R2_ACCOUNT_ID=
R2_BUCKET=surge
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# --- fleet -----------------------------------------------------------------
# Who may drive, and what they may drive: vehicles from the RDW register,
# identity through Stripe Identity, and the documents a reviewer approves.
#
# fake verifies whoever asks; unset, the service refuses to start rather than
# approving drivers nobody checked.
FLEET_IDENTITY_PROVIDER=fake
# A RESTRICTED Stripe key with Identity and nothing else. The key that moves
# money lives in payments, and this one must not be it.
STRIPE_IDENTITY_KEY=
# The signing secret for the identity endpoint, which is its own endpoint with
# its own secret: `stripe listen --forward-to localhost:8100/webhooks/stripe/identity`.
STRIPE_IDENTITY_WEBHOOK_SECRET=
# memory hands out links that go nowhere; r2 needs the R2_* credentials above.
FLEET_DOCUMENT_STORE=memory
FLEET_DOCUMENT_BUCKET=surge-documents
# The Dutch vehicle register: open data, no key, no account. fake answers from
# a table of five plates for working offline.
FLEET_REGISTER=rdw
RDW_ENDPOINT=
# Optional. Without one the register throttles by IP against a shared pool.
RDW_APP_TOKEN=
# What reads an insurance certificate before a reviewer does: claude, fake or
# off. It only saves the reviewer typing; nothing is decided by it.
FLEET_READER=off
ANTHROPIC_API_KEY=
FLEET_GRPC_LISTEN=:8115
FLEET_METRICS_ADDR=:9110
# How often the papers that ran out overnight are swept up.
FLEET_SWEEP_INTERVAL=1h

# The trip service holds a booking in payment_pending until payments reports
# the fare held, and only then asks for a driver. Unset means false: the flow
# from before payments existed, which a machine without it still needs.
TRIP_REQUIRE_PAYMENT=true
