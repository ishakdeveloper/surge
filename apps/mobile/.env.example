# apps/mobile reads these when the bundle is built. Expo loads `.env` from this
# directory, not the repository root, so copy this to apps/mobile/.env to
# override anything.
#
# Unset, each address defaults to the machine running `expo start`, on the
# local ports. A phone on the same network then reaches the laptop with no
# configuration — which `localhost` would not do, because on a phone localhost
# is the phone. Set them for anything that is not a dev server on this network.
#
# EXPO_PUBLIC_SURGE_API_URL=http://192.168.1.20:8100
# EXPO_PUBLIC_SURGE_WS_URL=ws://192.168.1.20:8100/ws
# EXPO_PUBLIC_AUTH_BASE_URL=http://192.168.1.20:3200

# Set when payments run against Stripe, as VITE_STRIPE_PUBLISHABLE_KEY is for
# the web app. Unset means the fake processor, and the app offers its test card.
# EXPO_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# The map. Two tokens, and they are not interchangeable:
#
# The public one ships inside the bundle and signs every tile request. Scope it
# to styles:read and tiles:read and restrict it to this app's bundle id in
# Mapbox; it is readable by anyone holding the app, so its safety is the scope
# and not the secrecy.
# EXPO_PUBLIC_MAPBOX_TOKEN=pk....
#
# The secret one is the build's. It carries DOWNLOADS:READ, which is what
# fetches Mapbox's native SDK while the app compiles, and it never reaches a
# phone. A cloud build reads the EAS environment variable of the same name:
#
#   npx eas-cli@latest env:create --name MAPBOX_DOWNLOADS_TOKEN --value sk....
#
# MAPBOX_DOWNLOADS_TOKEN=sk....

# Expo Go cannot run this app. The map's native SDK, and the background
# location a driver on shift needs, are both more than Expo Go carries — so
# development happens on a development build (`make mobile-build-sim`, or
# `pnpm exec expo run:ios`).
