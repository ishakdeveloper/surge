{
  "extends": "../../tsconfig.base.json",
  "include": ["src", "test"],
  "references": [
    { "path": "../../packages/domain" },
    { "path": "../../packages/client" },
    { "path": "../../packages/common" }
  ],
  "compilerOptions": {
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "types": ["node", "vite/client"],
    "tsBuildInfoFile": ".tsbuildinfo/app.tsbuildinfo",
    "paths": {
      "@/*": ["${configDir}/src/*"],
      "@test/*": ["${configDir}/test/*"],
      "@surge/client/*": ["../../packages/client/src/*.js"],
      "@surge/common/*": ["../../packages/common/src/*.js"],
      "@surge/domain/*": ["../../packages/domain/src/*.js"]
    }
  }
}
