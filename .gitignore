node_modules/
build/
dist/
.output/
.tanstack/
.tsbuildinfo/
*.tsbuildinfo
coverage/

.direnv/
result
result-*

# Every .env but the committed examples. `.env` and `.env.local` were listed
# one by one, which left `.env.production` — the one that would hold a live
# Stripe key — perfectly committable.
.env
.env.*
!.env.example

.claude/
.context/
.zed/
.DS_Store

# Expo: the dev server's cache, its generated types, and `expo prebuild`
# output — the native projects are generated from app.json, never edited.
.expo/
expo-env.d.ts
apps/mobile/ios/
apps/mobile/android/

# Go
backend/bin/

# Cluster secrets are created imperatively, never committed. This is a filled-in
# copy of deploy/k8s/development/secrets.template.yaml, should one be made —
# under any directory, because a Secret in the wrong one is still a Secret.
secrets.yaml
secrets.yml

# Anything holding a cloud credential. There is no service-account key in this
# project by design (CI federates an identity instead), and the way to keep it
# that way is for one to be uncommittable if it ever appears.
service-account*.json
*-service-account.json
gha-creds-*.json

# Playwright's traces, videos and report.
e2e/test-results/
e2e/playwright-report/
e2e/blob-report/

# OpenTofu's provider cache, any local state, and the variable files that name
# a real project. State lives in GCS; the provider lock file is committed.
.terraform/
*.tfstate
*.tfstate.*
*.tfvars
*.tfvars.json

# Python bytecode from running the benchmark scripts.
__pycache__/

# Impeccable's review captures and question logs: working material for a
# design round, not the design. PRODUCT.md, DESIGN.md and the surface briefs
# are what it leaves behind.
**/.impeccable/review/
**/.impeccable/questions/
