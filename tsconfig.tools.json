{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "incremental": false,
    "noEmit": true,
    // The vitest configs import `vitest.shared.ts` by its real extension, which
    // the bundler resolves and `tsc` only accepts when it is not emitting.
    "allowImportingTsExtensions": true,
    "types": ["node"]
  },
  "include": [
    "*.ts",
    ".railway/*.ts",
    "apps/*/vite.config.ts",
    "apps/*/vitest.config.ts",
    "apps/*/vitest.config.mts",
    "packages/*/vite.config.ts",
    "packages/*/vitest.config.ts"
  ]
}
